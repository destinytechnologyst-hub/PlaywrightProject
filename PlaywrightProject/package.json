{
  "name": "playwrightframework",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "bdd": "cucumber-js --format allure-cucumberjs/reporter",
    "bdd:login": "cucumber-js --tags \"@login\" --format allure-cucumberjs/reporter",
    "bdd:orangehrm": "cucumber-js --tags \"@orangehrm\" --format allure-cucumberjs/reporter",
    "mcp:playwright": "npx @playwright/mcp",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "^1.62.1",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.12.0",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
